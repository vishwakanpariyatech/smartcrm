# SmartCRM Environment Configuration

# Security
SECRET_KEY=django-insecure-smartcrm-enterprise-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (sqlite or mysql)
DB_ENGINE=sqlite
DB_NAME=smartcrm_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email Configuration (Optional SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=SmartCRM <noreply@smartcrm.local>
